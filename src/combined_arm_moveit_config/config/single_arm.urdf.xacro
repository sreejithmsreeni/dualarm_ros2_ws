<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="single_arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import single_arm urdf file -->
    <xacro:include filename="$(find dual_arm_description)/urdf/dual_arm.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="single_arm.ros2_control.xacro" />


    <xacro:single_arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
